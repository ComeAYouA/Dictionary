<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/motion_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:background="@drawable/edit_text_new">

        <ImageButton
            android:id="@+id/word_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:background="@null"
            android:src="@drawable/ic_empty_picture"
            app:layout_constraintBottom_toBottomOf="@id/motion_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/motion_layout"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/word_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/word_icon"
            app:layout_constraintTop_toTopOf="@+id/word_icon" />


        <com.lithium.kotlin.dictionary.common.ui.customviews.EllipticalListView
            android:id="@+id/translations_elliptical_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:backColor="@color/light_gray_300"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/word_text_view"
            app:layout_constraintTop_toBottomOf="@+id/word_text_view" />

        <com.lithium.kotlin.dictionary.common.ui.customviews.EllipticalListView
            android:id="@+id/categories_elliptical_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            app:backColor="@color/light_blue_300"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/word_text_view"
            app:layout_constraintTop_toBottomOf="@+id/translations_elliptical_view" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>